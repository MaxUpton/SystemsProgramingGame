  m_Script: {fileID: 11500000, guid: 16563ce904561d34ebd1b2688a76bb87, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  question: 'Shared locks: Allows multiple processes to read data concurrently No
    process can modify data while shared locks exist Optimizes performance for read-heavy
    workloads Compatible with other shared locks, incompatible with exclusive locks 
    Write locks: Grants exclusive access to a resource for modification Prevents
    all other processes from reading or writing Ensures data integrity during updates
    Incompatible with both shared and other exclusive locks Which lock combination
    does NOT result in a deadlock?  '
  rewardItem: {fileID: 11400000, guid: 6e2e3aa77f2f23c4095ee48ce01a128e, type: 2}
  userAnswer: c) Shared lock & Shared lock
  questionType: 1
  choiceA: a) Shared lock & Write lock
  choiceB: b) Write lock & Write lock
  choiceC: c) Shared lock & Shared lock
  choiceD: d) Write lock & Shared Lock
